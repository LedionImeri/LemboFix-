# Copy to .env (git-ignored) or use config/local.php — both are supported.
# Real environment variables (e.g. Apache SetEnv) override both.

APP_ENV=development
# Base path of the app. Leave empty to auto-detect (e.g. /lembofix under XAMPP htdocs)
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lembofix
DB_USER=root
DB_PASS=

# LemboBot (https://console.groq.com/keys). Without a key LemboBot runs in basic mode.
GROQ_API_KEY=YOUR_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b
# Optional: path to cacert.pem if cURL cannot verify SSL certificates on Windows
GROQ_CA_BUNDLE=
